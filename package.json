{
  "name": "jarvis",
  "private": true,
  "version": "0.0.0",
  "description": "A browser voice assistant with an Iron Man holographic interface, driven by Claude Code through a small Node bridge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:writes": "JARVIS_ALLOW_WRITES=1 node bridge/server.mjs",
    "setup": "node scripts/setup.mjs",
    "app": "npm run build && electron .",
    "app:dev": "electron . --dev",
    "app:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "/package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app/dist"
      },
      {
        "from": "bridge",
        "to": "app/bridge"
      },
      {
        "from": "package.json",
        "to": "app/package.json"
      },
      {
        "from": "node_modules/@anthropic-ai",
        "to": "app/node_modules/@anthropic-ai"
      },
      {
        "from": "node_modules/ws",
        "to": "app/node_modules/ws"
      },
      {
        "from": "node_modules/zod",
        "to": "app/node_modules/zod"
      },
      {
        "from": "node_modules/standardwebhooks",
        "to": "app/node_modules/standardwebhooks"
      },
      {
        "from": "node_modules/json-schema-to-ts",
        "to": "app/node_modules/json-schema-to-ts"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JARVIS слушает ваши команды через микрофон.",
        "NSCameraUsageDescription": "JARVIS использует камеру для управления жестами и для того, чтобы видеть то, что вы показываете.",
        "NSAppleEventsUsageDescription": "JARVIS управляет другими программами по вашим голосовым командам."
      }
    },
    "asar": false
  }
}